      "slug": "werkzeug-anfrage",
      "component": "WerkzeugAnfrage",
      "title": "Werkzeug anfragen",
      "endpoints": [
        {
          "entity": "werkzeuge",
          "op": "list",
          "fields": [
            "bezeichnung",
            "inventarnummer",
            "status"
          ],
          "scope": "r.v_status == 'verfuegbar'",
          "scope_description": "zeigt nur Werkzeuge mit Status 'Verfügbar'",
          "max_records": 200
        },
        {
          "entity": "ausleihen",
          "op": "list",
          "fields": [
            "werkzeug",
            "ausgabe",
            "rueckgabe_geplant",
            "rueckgabe_erfolgt"
          ],
          "scope": "r.v_rueckgabe_erfolgt is None",
          "scope_description": "zeigt nur aktive Ausleihen ohne abgeschlossene Rückgabe — für die tagesbasierte Verfügbarkeitsprüfung",
          "max_records": 500
        },
        {
          "entity": "ausleihen",
          "op": "create",
          "fields": [
            "werkzeug",
            "ausgabe",
            "rueckgabe_geplant"
          ]
        }
      ]
    },
    {
      "slug": "schaden-melden",
      "component": "SchadenMelden",
      "title": "Schaden melden",
      "endpoints": [
        {
          "entity": "werkzeuge",
          "op": "list",
          "fields": [
            "bezeichnung",
            "inventarnummer",
            "status"
          ],
          "scope_description": "zeigt alle Werkzeuge zur Auswahl"
